<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.pdcgithub</groupId>
    <artifactId>pdc-common-tool</artifactId>
    <packaging>pom</packaging>  <!-- 这里把类型修改为 pom。这里是 maven 的模块化项目中的 parent -->
    <version>1.2.0-jre8-SNAPSHOT</version>
    <name>pdc-common-tool</name>
    <description>This is a common toolkit of myself</description>
    <url>https://github.com/pdcGithub/pdc-common-tools</url>

    <!-- 这里定义的是 license 信息（maven 发布到中央仓库时用） -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://mit-license.org/</url>
        </license>
    </licenses>

    <!-- 这里定义的时 开发者信息（maven 发布到中央仓库时用） -->
    <developers>
        <developer>
            <id>mynameid</id>
            <name>Michael Pang ( Dongcan Pang )</name>
            <email>pangdongcan@live.com</email>
            <roles>
                <role>Project Manager</role>
                <role>Architect</role>
            </roles>
        </developer>
    </developers>
    
    <!-- scm 工具（maven 发布到中央仓库时用） -->
    <scm>
        <connection>https://github.com/pdcGithub/pdc-common-tools.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:pdcGithub/pdc-common-tools.git</developerConnection>
        <url>https://github.com/pdcGithub/pdc-common-tools</url>
    </scm>
    
    <!-- 这里定义的是 项目的子模块 -->
    <modules>
        <!-- 这是 core 核心包 -->
        <module>core</module>
        <!-- 这是 database 数据库包。依赖 core 包 -->
        <module>database</module>
        <!-- 这是 web 工具包。依赖 core 包 -->
        <module>web</module>
    </modules>

    <!-- 设置软件版本等参数 -->
    <properties>
        <!-- 定义开发和编译用的 JDK 版本信息 -->
        <jdk.version>1.8</jdk.version>
        <!-- 定义项目编码信息 -->
        <encoding>utf-8</encoding>
        <!-- 指定项目编码，防止 eclipse 出现 has no explicit encoding set -->
        <project.build.sourceEncoding>${encoding}</project.build.sourceEncoding>
        <!-- JUnit 的版本信息 -->
        <junit.version>5.13.4</junit.version>
    </properties>

    <!-- 这里定义 父级别的编译处理 和 插件管理（对于 Managerment 标签，它们只声明，不直接启用。在子模块需要自己写） -->
    <build>
        
        <!-- 全部子项目统一使用的插件-->
        <plugins>
            
            <!-- 设置jdk编译插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <source>${jdk.version}</source>
                    <target>${jdk.version}</target>
                    <encoding>${encoding}</encoding>
                    <excludes>
                        <!-- 编译时，排除测试文件 -->
                    </excludes>
                </configuration>
            </plugin>
            
            <!-- 这里是 source 源码包的插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>2.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <!-- 这是 java doc 插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.3.2</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <!-- junit 5 测试插件。用于 mvn test 执行。在 mvn 打包前，会自动执行 mvn test 用于测试。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M7</version>
                <configuration>
                    <!-- 如果没有测试，不要失败 -->
                    <failIfNoTests>false</failIfNoTests>
                    <!-- 包含所有测试 -->
                    <includes>
                        <!-- 指定 单元测试类的命名方式，以便于搜索 Java 文件 -->
                        <include>**/*Tester*.java</include>
                    </includes>
                </configuration>
            </plugin>
            
            <!-- central 中央仓库发布插件 -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.4.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>myrepo</publishingServerId>
                    <tokenAuth>true</tokenAuth>
                </configuration>
            </plugin>
            
            <!-- gpg 验证插件 (发布到中央仓库时，再使用。gpg 工具在 Git bash 里面有) -->
            <!--
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>1.5</version>
                <configuration>
                    <executable>C:\Program Files\Git\usr\bin\gpg.exe</executable>
                    <keyname>pangdongcan</keyname>
                </configuration>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            -->
            
        </plugins>
        
        <!-- 共享插件管理（这里只是声明，然后子模块选择性使用） -->
        <pluginManagement>
            <plugins>
                
                <!-- 这是 jar 包插件 （因为不是每一个子模块都需要 jar 打包。所以算是可选的） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>2.4</version>
                    <configuration>
                        <excludes>
                            <!-- 打包时，排除测试文件 -->
                        </excludes>
                        <archive>
                            <manifest>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
                
            </plugins>
        </pluginManagement>
        
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <!--包含文件夹以及子文件夹下所有资源 -->
                    <include>**/*.*</include>
                </includes>
            </resource>
        </resources>
        
    </build>
    
    <!-- 这里定义全部子模块都需要强制使用的依赖 -->
    <dependencies>
        
        <!-- 这里是 单元测试 使用的一个工具包，一般没啥用。它的作用域是测试，并非最终打包 -->
        <!-- https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-api -->
        <!-- JUnit 5 API - 用于编写测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 5 引擎 - 用于执行测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 5 可选的：参数化测试支持 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        
        <!-- 日志记录 -->
        <!-- https://mvnrepository.com/artifact/org.slf4j/slf4j-api -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.7</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/ch.qos.logback/logback-classic -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.3.14</version>
        </dependency>
        
    </dependencies>
    
    <!-- 这里定义 父级别的第三方依赖 和 依赖管理（对于 Managerment 标签，它们只声明，不直接启用。在子模块需要自己写） -->
    <dependencyManagement>
        <dependencies>
            
            <!-- 数据库连接池 HikariCP java8 版用 4.0 版本 -->
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>4.0.3</version>
            </dependency>
            
            <!--添加mysql的jdbc工具包，8.0.31 和 老版本的路径不同 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>8.4.0</version>
            </dependency>
            
            <!-- https://mvnrepository.com/artifact/com.oracle.database.jdbc/ojdbc6 -->
            <!--添加 Oracle 的jdbc工具包 用于oracle11g -->
            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc8</artifactId>
                <version>23.2.0.0</version>
            </dependency>
            
            <!-- https://mvnrepository.com/artifact/com.microsoft.sqlserver/mssql-jdbc -->
            <!-- 添加 MS SQL Server jdbc 包。 -->
            <dependency>
                <groupId>com.microsoft.sqlserver</groupId>
                <artifactId>mssql-jdbc</artifactId>
                <version>13.2.1.jre8</version>
            </dependency>
            
            <!-- 添加 java mail 工具包 -->
            <dependency>
                <groupId>com.sun.mail</groupId>
                <artifactId>javax.mail</artifactId>
                <version>1.6.2</version>
            </dependency>
            
            <!-- https://mvnrepository.com/artifact/org.ansj/ansj_seg -->
            <!-- 分词器 -->
            <dependency>
                <groupId>org.ansj</groupId>
                <artifactId>ansj_seg</artifactId>
                <version>5.1.6</version>
            </dependency>
            
        </dependencies>
    </dependencyManagement>

</project>